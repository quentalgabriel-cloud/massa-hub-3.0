# Massa Hub — variaveis de ambiente. Copie para .env.local e preencha.
# NUNCA comitar .env.local (ja esta no .gitignore).

# Supabase (adapter de repositorio)
# Projeto: massa-hub-3.0 (org massa-hub, regiao sa-east-1/Sao Paulo).
# URL e anon/publishable key sao publicas. SERVICE_ROLE_KEY e secreta (so no painel).
NEXT_PUBLIC_SUPABASE_URL=https://bmwlxjtuhwrqvacnvnhc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_x-0n8-qkvjN6-l22TWJspQ_3DM6hcwe
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (adapter de extracao de ticket)
ANTHROPIC_API_KEY=
# Opcional — sobrescreve o modelo padrao (claude-haiku-4-5-20251001) sem deploy.
ANTHROPIC_MODEL=

# Envio de e-mail (convite de ativacao — Fase 2)
# OPCIONAL: sem esta chave o vinculo funciona igual, so nao envia convite —
# o assessor compartilha o link de reivindicacao manualmente.
# Criar em resend.com (free tier: 100 e-mails/dia, sem cartao).
RESEND_API_KEY=
# Remetente. Sem dominio verificado, o padrao do sandbox do Resend e usado.
# Com dominio proprio: "Massa <convite@massahub.com.br>".
EMAIL_REMETENTE=

# App
# Usada para montar o link do convite. No Vercel, cai para VERCEL_URL se vazia.
NEXT_PUBLIC_APP_URL=http://localhost:3000
